rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Eritrean Info music — public read so the audio player works without login
    match /eri_music/{file} {
      allow read:  if true;
      allow write: if request.auth != null;
    }

    // Everything else — authenticated users only
    match /{allPaths=**} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
